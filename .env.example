# =============================================================
# RUNTIME — obrigatório se você for usar os agendamentos
# =============================================================
# Usuário de serviço que executa os jobs do schedule.yaml.
# Os scripts de runtime usam `set -u`: sem esta variável eles
# abortam com 'RUN_USER: unbound variable' na primeira linha.
# Use uma conta dedicada, NUNCA root.
RUN_USER=seu-usuario-de-servico

# ============================================================================
# Segunda-feira Framework v7.5 — Environment Variables Template
# ============================================================================
# Copie este arquivo para ~/.env e preencha com suas credenciais.
# NUNCA commite ~/.env. Já está no .gitignore.
#
# Cada bloco abaixo diz para que serve a variável.
# ============================================================================

# ──────────────── OBRIGATÓRIO ──────────────────────────────────────────────

# Anthropic API (Claude) — obrigatório para o framework funcionar
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Seu nome (usado por agentes para personalização)
USER_NAME=Seu Nome

# ──────────────── OPCIONAIS — VOICE / VIDEO ────────────────────────────────

# ElevenLabs TTS (voz de alta qualidade no SEGUNDA-FEIRA voice)
# Obter em: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Fal.ai (gpt-image-2, video gen, voice clone)
# Obter em: https://fal.ai/dashboard/keys
FAL_KEY=

# HeyGen (avatares de vídeo)
# Obter em: https://app.heygen.com/settings/api
HEYGEN_API_KEY=

# ──────────────── OPCIONAIS — TRÁFEGO PAGO ─────────────────────────────────

# Meta Ads (Facebook/Instagram)
# Obter token em: https://developers.facebook.com/tools/explorer
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_123456789
META_APP_ID=
META_APP_SECRET=

# Google Ads (opcional)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# ──────────────── OPCIONAIS — VENDAS / FINANCEIRO ──────────────────────────

# Eduzz (plataforma de produtos digitais)
# Obter em: https://www.eduzz.com/orbita/api
EDUZZ_EMAIL=
EDUZZ_PASSWORD=
EDUZZ_PUBLIC_KEY=
EDUZZ_API_KEY=

# Asaas (cobrança e gestão financeira)
# Obter em: https://www.asaas.com/api
ASAAS_API_KEY=

# Greenn (gateway de pagamento)
GREENN_CLIENT_ID=
GREENN_CLIENT_SECRET=
GREENN_WEBHOOK_TOKEN=

# Resend (envio de email transacional)
# Obter em: https://resend.com/api-keys
RESEND_API_KEY=

# ──────────────── OPCIONAIS — INFRA / DEPLOY ───────────────────────────────

# VPS principal (use SUAS credenciais — nunca compartilhe)
VPS_HOST=
VPS_USER=root
VPS_PASS=

# Hostinger (se usar)
HOSTINGER_HOST=
HOSTINGER_PORT=22
HOSTINGER_USER=
HOSTINGER_PASS=

# Registro.br (automação de domínios via Playwright)
REGISTRO_BR_USER=
REGISTRO_BR_PASS=

# Gmail OAuth (se usar Gmail MCP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ──────────────── OPCIONAIS — REDES SOCIAIS ────────────────────────────────

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Data API
YOUTUBE_API_KEY=

# Telegram (se usar bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Business / Evolution API
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=

# ──────────────── INTERNO — não mexer a menos que saiba o que faz ──────────

# Path do framework (auto-detectado, não precisa mudar)
# SEGUNDA_FEIRA_HOME=$HOME/segunda-feira

# Modelo padrão para subagents (claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5)
DEFAULT_AGENT_MODEL=claude-sonnet-4-6

# ──────────────── IDENTIDADE & DOMÍNIO (v7.14) ─────────────────────────────
# Usados por agentes/skills para personalizar saída e apontar deploys.
BASE_DOMAIN=seudominio.com.br
CEO_INSTAGRAM=@seuinstagram
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PHONE=
# Senha de banco de dados de apps (se usar deploy automatizado)
DB_PASSWORD=
# Credencial de auth HTTP de exemplo (NUNCA hardcode — leia daqui)
CLIENT_AUTH=
